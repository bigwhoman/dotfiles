# ── Reading colors: warm "book page" (sepia) ───────────────────────────
# recolor maps the page's white -> lightcolor and black -> darkcolor
set recolor                  true
# paper
set recolor-lightcolor       "#f4ecd8"
# ink
set recolor-darkcolor        "#4a3b2a"
set recolor-keephue          false
# keep figures/images in their real colors
set recolor-reverse-video    true

# ── UI colors: soft warm grey to match the page ────────────────────────
set default-bg               "#e8e1d0"
set default-fg               "#3b3127"
set statusbar-bg             "#d9d0bc"
set statusbar-fg             "#3b3127"
set inputbar-bg              "#e8e1d0"
set inputbar-fg              "#3b3127"
set notification-bg          "#d9d0bc"
set notification-fg          "#3b3127"
set notification-error-bg    "#c97b63"
set notification-error-fg    "#f4ecd8"
set notification-warning-bg  "#d8b46a"
set notification-warning-fg  "#3b3127"
set completion-bg            "#e8e1d0"
set completion-fg            "#3b3127"
set completion-highlight-bg  "#c9bd9f"
set completion-highlight-fg  "#3b3127"
set index-bg                 "#f4ecd8"
set index-fg                 "#3b3127"
set index-active-bg          "#c9bd9f"
set index-active-fg          "#3b3127"

# ── Highlighting ───────────────────────────────────────────────────────
# Shift + left-drag draws a highlight box; search hits use the same colors.
# (Note: zathura highlights are visual only — not saved into the PDF.)
set highlighter-modifier     "shift"
# soft marker yellow
set highlight-color          "rgba(240, 200, 80, 0.45)"
set highlight-fg             "#3b3127"
# current search hit
set highlight-active-color   "rgba(220, 140, 60, 0.55)"
set incremental-search       true

# Selecting text with the mouse copies it to the system clipboard
set selection-clipboard      clipboard

# ── Scrolling: ~one line of text per j/k ───────────────────────────────
# pixels; tweak to match your zoom
set scroll-step              24
set scroll-hstep             24
set scroll-page-aware        true
set smooth-scroll            true
# keep a little context on page-down
set scroll-full-overlap      0.05

# ── Layout / misc ──────────────────────────────────────────────────────
set font                     "monospace 11"
set adjust-open              "width"
set pages-per-row            1
set page-padding             4
# statusbar only, no inputbar until ':'
set guioptions               "s"
set window-title-basename    true

# ── Keys ───────────────────────────────────────────────────────────────
# one line down
map j  scroll down
# one line up
map k  scroll up
# next page
map J  navigate next
# previous page
map K  navigate previous
map d  scroll half-down
map u  scroll half-up
map +  zoom in
map -  zoom out
map r  reload
# toggle sepia <-> original
map i  recolor
# two-page view
map D  toggle_page_mode

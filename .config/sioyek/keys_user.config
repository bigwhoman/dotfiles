# Sioyek user keys - overrides/extends the built-in keys.config
# Keyboard-only reading. Built-in keys not listed here still work.

# -- Reading line (ruler) --
# R: put the ruler on the screen; then j/k move it one line at a time
enter_visual_mark_mode   R
move_visual_mark_down    j
move_visual_mark_up      k
close_visual_mark        <esc>

# -- Pages --
# h/l scroll sideways (only moves when zoomed past page width)
move_right               h
move_left                l
next_page                J
previous_page            K
screen_down              <C-d>
screen_up                <C-u>

# -- Focus word / text cursor (keyboard selection) --
# v   label every word on screen, type labels for start and end
keyboard_select          v
# V   select the whole ruler line, then grow/shrink it below
select_ruler_text        V
# w/b move the selection edge one word,
# Ctrl-j / Ctrl-k one line down / up
move_text_mark_forward_word    w
move_text_mark_backward_word   b
move_text_mark_down            <C-j>
move_text_mark_up              <C-k>
# x   swap which end of the selection moves (like vim's o in visual mode)
toggle_text_mark         x
# y   copy selection
copy                     y

# -- Highlights (saved in sioyek's database) --
# a then a letter (y/g/b/r/p) highlights the selection with that color
add_highlight            a
# dh delete, gh list, gnh / gNh next / previous highlight (built-in)
# A   attach a text note to the highlight you just made
add_annot_to_highlight   A

# b is now word-back, so bookmarks move to B
add_bookmark             B

# gd: label only the PDF links on screen (like f), type one to preview it in a popup
overview_link            gd
# go: label every word, for papers without clickable links (Sioyek guesses the target)
keyboard_overview        go
# gD: preview the reference on the ruler line (needs R first; was l)
overview_definition      gD

# -- View --
# Ctrl+= / Ctrl+- zoom like a browser (built-in is only + and -)
zoom_in                  <C-=>
zoom_in                  <C-+>
zoom_out                 <C-->
fit_to_page_width        <C-0>
toggle_custom_color      i
toggle_dark_mode         <f8>
toggle_statusbar         <f3>

# -- Same muscle memory as nvim --
# s / S: label jump, like flash.nvim (s = select words, S = jump to ref/figure)
keyboard_select          s
keyboard_smart_jump      S
# Ctrl-o / Ctrl-i: jump back / forward, like the vim jumplist
prev_state               <C-o>
next_state               <C-i>

# ?: searchable list of every command (closest thing to which-key)
command_palette          ?

# -- Portals (p to create, F12 helper window, gp / dp built-in) --
# gP: searchable list of this document's portals (like gb for bookmarks, gh for highlights)
goto_portal_list         gP

# -- Search --
# / searches from the current page onward (1/N = next match after where you are).
# g/ searches from the start of the document instead; Ctrl-o jumps back to where you were.
goto_beginning;search    g/

# Sioyek user prefs - overrides the built-in prefs.config
# Colors are "R G B" (or "R G B A") floats in 0..1

check_for_updates_on_startup    0

# -- Book-page colors (applied by toggle_custom_color, on at startup) --
# paper  #f4ecd8  ink  near-black #141210
custom_background_color         0.957 0.925 0.847
custom_text_color               0.078 0.071 0.063
# area around the pages: warm grey  #e2dccd
background_color                0.886 0.863 0.804

startup_commands                toggle_custom_color

# -- Status bar --
status_bar_color                0.851 0.816 0.737
status_bar_text_color           0.231 0.192 0.153

# -- Ruler (reading line) --
# mask everything except the current line
ruler_mode                      1
ruler_padding                   1.0
ruler_x_padding                 5.0
# light warm tint over the non-focused lines
visual_mark_color               0.40 0.33 0.22 0.12
# when the ruler moves past this point, scroll so it sits near the top
visual_mark_next_page_fraction  0.6
visual_mark_next_page_threshold 0.2

# -- Selection / search --
text_highlight_color            0.95 0.78 0.31
search_highlight_color          0.86 0.55 0.24

# -- Highlight palette (press h then the letter) --
# y yellow, g green, b blue, r red, p pink: softened to suit sepia
highlight_color_y               0.98 0.86 0.40
highlight_color_g               0.62 0.84 0.55
highlight_color_b               0.55 0.72 0.90
highlight_color_r               0.92 0.55 0.50
highlight_color_p               0.95 0.68 0.78

# -- Movement --
# j/k outside the ruler: ~ a few lines (inches)
vertical_move_amount            0.3

# -- Keyboard labels (v / s / S / f / gd) --
# fixed pixel size, doesn't scale with zoom (default 20)
keyboard_select_font_size       14
# v / s selection includes the end word. The default (exclusive) mode breaks around
# punctuation: commas get their own label, and starting on one selects nothing.
keyboard_select_inclusive       1

# -- Sync --
# Highlights, bookmarks and portals live in the git-tracked refs library, so they travel
# with the PDFs. Matched by file content, so paths may differ per machine.
# Commit/pull with Sioyek closed, otherwise git may grab a half-written database.
shared_database_path    /home/bigwhoman/refs/.sioyek/shared.db
